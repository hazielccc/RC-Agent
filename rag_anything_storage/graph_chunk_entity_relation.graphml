</node>
<node id="Shanghai Pudong Development Bank">
  <data key="d0">Shanghai Pudong Development Bank</data>
  <data key="d1">organization</data>
  <data key="d2">Shanghai Pudong Development Bank is where Yang held various positions and facilitated the approval of stock pledge business.</data>
  <data key="d3">chunk-7d165ce25e58cf7e24e46962ff373a86</data>
