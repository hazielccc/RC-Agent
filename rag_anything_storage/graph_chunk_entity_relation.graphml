</node>
<node id="Lu Mouxuan">
  <data key="d0">Lu Mouxuan</data>
  <data key="d1">person</data>
  <data key="d2">Lu Mouxuan, the legal representative of Zhongtong Machinery Manufacturing Co., Ltd., participated in the financial fraud.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Lu Mouguang">
  <data key="d0">Lu Mouguang</data>
  <data key="d1">person</data>
  <data key="d2">Lu Mouguang, the former chief financial officer of Zhongtong Machinery Manufacturing Co., Ltd., participated in the financial fraud.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Li Accounting Firm">
  <data key="d0">Li Accounting Firm</data>
  <data key="d1">organization</data>
  <data key="d2">Li Accounting Firm provided an audit report containing significant false information for Zhongtong Machinery Manufacturing Co., Ltd.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Yang Moujie">
  <data key="d0">Yang Moujie</data>
  <data key="d1">person</data>
  <data key="d2">Yang Moujie, the deputy director of Li Accounting Firm, organized and managed the issuance of the false audit report.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Chen Mouming">
  <data key="d0">Chen Mouming</data>
  <data key="d1">person</data>
  <data key="d2">Chen Mouming, an employee of Li Accounting Firm, was responsible for on-site auditing and drafting the initial report.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Wang Mouyu">
  <data key="d0">Wang Mouyu</data>
  <data key="d1">person</data>
  <data key="d2">Wang Mouyu, a certified public accountant at Li Accounting Firm, signed the audit report without proper review.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Bian Mou">
  <data key="d0">Bian Mou</data>
  <data key="d1">person</data>
  <data key="d2">Bian Mou, a director of the fixed income financing department of a securities company, participated in the preparation of the bond prospectus and received a bribe from Zhongtong Machinery Manufacturing Co., Ltd.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
