</node>
<node id="内核">
  <data key="d0">内核</data>
  <data key="d1">method</data>
  <data key="d2">内核是对并购协议的进一步审核，确保其内容完整、合规。</data>
  <data key="d3">chunk-008da0ebf1260eb0b2aa14694543e31a</data>
