</node>
<node id="Outsourcing Institution">
  <data key="d0">Outsourcing Institution</data>
  <data key="d1">organization</data>
  <data key="d2">The Outsourcing Institution is a third-party service provider that handles various operational and back-office support activities for the Fund Manager.</data>
  <data key="d3">chunk-908a90bfb004325d95720427d14fe150</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
