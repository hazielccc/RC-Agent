  <data key="d6"></data>
</node>
<node id="Stock Pledge Business">
  <data key="d0">Stock Pledge Business</data>
  <data key="d1">method</data>
  <data key="d2">The Stock Pledge Business involves the pledging of stocks as collateral for loans, with various stages including funding, pledge management, and repurchase.</data>
  <data key="d3">chunk-7d165ce25e58cf7e24e46962ff373a86</data>
