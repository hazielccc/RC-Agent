</node>
<node id="Zhongtong Machinery Manufacturing Co., Ltd.">
  <data key="d0">Zhongtong Machinery Manufacturing Co., Ltd.</data>
  <data key="d1">organization</data>
  <data key="d2">Zhongtong Machinery Manufacturing Co., Ltd. engaged in financial fraud to issue private placement bonds and was involved in bribery.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
