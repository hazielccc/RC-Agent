  <data key="d1">organization</data>
  <data key="d2">易所试是一家位于上海的互联网营销公司，主要从事试用体验及口碑营销服务等，股票代码为430309.OC。</data>
  <data key="d3">chunk-8f49f073a32a9b70da3ff66d5b316f66</data>
