  <data key="d6"></data>
</node>
<node id="Fund Operation Outsourcing Agreement">
  <data key="d0">Fund Operation Outsourcing Agreement</data>
  <data key="d1">content</data>
  <data key="d2">The Fund Operation Outsourcing Agreement is a contract between the Fund Manager and the Securities Company that outlines the terms and conditions of the outsourcing services.</data>
  <data key="d3">chunk-908a90bfb004325d95720427d14fe150</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Fund Industry Association">
  <data key="d0">Fund Industry Association</data>
  <data key="d1">organization</data>
  <data key="d2">The Fund Industry Association is a regulatory body that receives reports from the Outsourcing Institution regarding the outsourcing business and operations.</data>
  <data key="d3">chunk-908a90bfb004325d95720427d14fe150</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Regulatory Requirements">
  <data key="d0">Regulatory Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Regulatory Requirements refer to the laws, regulations, and standards that the Outsourcing Institution must comply with to ensure the legality and compliance of the fund operations.</data>
  <data key="d3">chunk-908a90bfb004325d95720427d14fe150</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Fund Operation Outsourcing Service">
  <data key="d0">Fund Operation Outsourcing Service</data>
  <data key="d1">service</data>
  <data key="d2">The Fund Operation Outsourcing Service includes various activities such as sales, payment, share registration, valuation, and IT system support provided by the Securities Company to the Fund Manager.</data>
  <data key="d3">chunk-908a90bfb004325d95720427d14fe150</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Third-Party Service Provider">
  <data key="d0">Third-Party Service Provider</data>
  <data key="d1">organization</data>
  <data key="d2">The Third-Party Service Provider is an external entity that the Fund Manager can outsource operational and back-office support activities to.</data>
  <data key="d3">chunk-908a90bfb004325d95720427d14fe150</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068936</data>
  <data key="d6"></data>
</node>
<node id="Securities Company (Lead Underwriter)">
  <data key="d0">Securities Company (Lead Underwriter)</data>
  <data key="d1">organization</data>
  <data key="d2">The Securities Company, acting as the lead underwriter, is responsible for market promotion, roadshows, and determining the final issue price and interest rate based on market demand and investor feedback.</data>
  <data key="d3">chunk-9a7158aeec0dad8fd76e33597896e63c</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
