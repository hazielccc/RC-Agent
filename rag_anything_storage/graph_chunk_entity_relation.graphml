  <data key="d6"></data>
</node>
<node id="Credit Funds Account">
  <data key="d0">Credit Funds Account</data>
  <data key="d1">artifact</data>
  <data key="d2">Credit Funds Account is an account type used in margin trading to manage the funds related to the client's margin trading activities.</data>
  <data key="d3">chunk-d77b36439da8f8202fe97a3d1f6b5a70</data>
