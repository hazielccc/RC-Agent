  <data key="d0">Shenzhen Yuan Investment Development Company</data>
  <data key="d1">organization</data>
  <data key="d2">Shenzhen Yuan Investment Development Company is a company that falsely subscribed to 60 million yuan of the bonds issued by Jiangsu Tech Company.</data>
  <data key="d3">chunk-544ad37a02e1d092cc5521f45d203638</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068926</data>
  <data key="d6"></data>
</node>
<node id="Real Company">
  <data key="d0">Real Company</data>
  <data key="d1">organization</data>
  <data key="d2">Real Company is an entity that actually subscribed to 27 million yuan of the bonds issued by Jiangsu Tech Company.</data>
  <data key="d3">chunk-544ad37a02e1d092cc5521f45d203638</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068926</data>
  <data key="d6"></data>
</node>
<node id="Zhang Rukai">
  <data key="d0">Zhang Rukai</data>
  <data key="d1">person</data>
  <data key="d2">Zhang Rukai is the former legal representative and general manager of a company that arranged a false agreement with Huabei Securities.</data>
  <data key="d3">chunk-544ad37a02e1d092cc5521f45d203638</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068926</data>
  <data key="d6"></data>
</node>
