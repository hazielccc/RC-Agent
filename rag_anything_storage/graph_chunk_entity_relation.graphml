  <data key="d13">1780068947</data>
  <data key="d14"></data>
</edge>
<edge source="发行人" target="成长企业融资业务">
  <data key="d8">1.0</data>
  <data key="d9">成长企业融资业务为发行人提供金融服务，帮助其在全国中小企业股份转让系统挂牌。</data>
