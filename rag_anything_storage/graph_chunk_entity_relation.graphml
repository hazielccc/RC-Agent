</node>
<node id="Liu Wei">
  <data key="d0">Liu Wei</data>
  <data key="d1">person</data>
  <data key="d2">Liu Wei is a former fund manager at Zhejiang Business Fund Management Co., Ltd. who engaged in insider trading using another person's securities account.&lt;SEP&gt;Liu Wei used the "Tang Mouqing" account to conduct synchronized trades amounting to 17.6024 million yuan.</data>
  <data key="d3">chunk-a7f12cdeb483c7deb72fe0b6a5c6a479&lt;SEP&gt;chunk-a0a629b4d3e1e1458cb010f20fc5e1e6</data>
