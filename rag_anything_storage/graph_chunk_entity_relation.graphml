  <data key="d6"></data>
</node>
<node id="Pledged Securities">
  <data key="d0">Pledged Securities</data>
  <data key="d1">data</data>
  <data key="d2">Pledged Securities are the stocks that are used as collateral in the stock pledge business and are subject to market value assessment and monitoring.</data>
  <data key="d3">chunk-7d165ce25e58cf7e24e46962ff373a86</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068935</data>
  <data key="d6"></data>
</node>
<node id="Yang">
  <data key="d0">Yang</data>
  <data key="d1">person</data>
  <data key="d2">Yang is a former employee of the Shanghai Pudong Development Bank who was convicted of accepting bribes to facilitate the extension of stock pledge business.</data>
  <data key="d3">chunk-7d165ce25e58cf7e24e46962ff373a86</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
