  <data key="d6"></data>
</node>
<node id="Credit Fund Account">
  <data key="d0">Credit Fund Account</data>
  <data key="d1">account</data>
  <data key="d2">The Credit Fund Account is opened by the custodian bank for the investor to hold the margin funds.</data>
  <data key="d3">chunk-7fb11b0587a7113559ef65ba6e8e5d02</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
