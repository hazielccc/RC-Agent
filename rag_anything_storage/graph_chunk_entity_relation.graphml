  <data key="d6"></data>
</node>
<node id="Chuangyi Company">
  <data key="d0">Chuangyi Company</data>
  <data key="d1">organization</data>
  <data key="d2">Chuangyi Company is a company controlled by Zhang Rukai that received 5 million yuan from Huabei Securities under a false agreement.</data>
  <data key="d3">chunk-544ad37a02e1d092cc5521f45d203638</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
