  <data key="d6"></data>
</node>
<node id="Zhejiang Hong Kong Shenzhen Selected Fund">
  <data key="d0">Zhejiang Hong Kong Shenzhen Selected Fund</data>
  <data key="d1">fund</data>
  <data key="d2">Zhejiang Hong Kong Shenzhen Selected Fund is a mixed-type securities investment fund managed by Liu Wei, involved in the insider trading case.</data>
  <data key="d3">chunk-a7f12cdeb483c7deb72fe0b6a5c6a479</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
