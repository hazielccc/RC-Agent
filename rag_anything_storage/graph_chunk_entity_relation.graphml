<node id="Stock Pledge Repurchase Business">
  <data key="d0">Stock Pledge Repurchase Business</data>
  <data key="d1">method</data>
  <data key="d2">Stock Pledge Repurchase Business is a financial service where clients can obtain funds by pledging their stocks.</data>
