  <data key="d5">1780068935</data>
  <data key="d6"></data>
</node>
<node id="Tang Mouqing Securities Account">
  <data key="d0">Tang Mouqing Securities Account</data>
  <data key="d1">account</data>
  <data key="d2">Tang Mouqing Securities Account is a securities account controlled and operated by Liu Wei, used for conducting similar trades with the public fund managed by Liu Wei.</data>
  <data key="d3">chunk-a7f12cdeb483c7deb72fe0b6a5c6a479</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
