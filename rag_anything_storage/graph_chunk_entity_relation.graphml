  <data key="d6"></data>
</node>
<node id="Asset Management Subsidiary">
  <data key="d0">Asset Management Subsidiary</data>
  <data key="d1">organization</data>
  <data key="d2">The Asset Management Subsidiary manages collective asset management plans or directed asset management clients for the Securities Company.</data>
  <data key="d3">chunk-7d165ce25e58cf7e24e46962ff373a86</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
