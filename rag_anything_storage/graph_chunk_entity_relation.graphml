  <data key="d6"></data>
</node>
<node id="Consultation Fee">
  <data key="d0">Consultation Fee</data>
  <data key="d1">data</data>
  <data key="d2">The consultation fee is a charge collected by Shanghai HCF after the transfer of shares.</data>
  <data key="d3">chunk-f88db09cf8ffc393a8809d56be486363</data>
  <data key="d4">1.5证券业精细化洗钱风险管控体系建设研究报告.docx</data>
  <data key="d5">1780068934</data>
  <data key="d6"></data>
</node>
<node id="Regional Equity Market Transaction Service">
  <data key="d0">Regional Equity Market Transaction Service</data>
  <data key="d1">method</data>
  <data key="d2">The Regional Equity Market Transaction Service is a platform where potential money laundering risks, such as unclear sources of funds, can be monitored.</data>
  <data key="d3">chunk-f88db09cf8ffc393a8809d56be486363</data>
